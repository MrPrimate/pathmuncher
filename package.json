{
  "name": "pathmuncher",
  "version": "2.0.0",
  "author": "MrPrimate",
  "description": "Foundry VTT module for integrating Pathfinder 2e Pathbuilder characters",
  "private": true,
  "scripts": {
    "lint": "npx eslint src/ tests/",
    "lint-fix": "npx eslint src/ tests/ --fix",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/unit/setup.mjs --test --test-concurrency=1 \"tests/unit/**/*.test.mjs\"",
    "build": "webpack",
    "test:foundry": "node tests/foundry/run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "3.1.0",
    "terser": "^5.10.0",
    "terser-webpack-plugin": "^5.3.0",
    "webpack": "^5.49.0",
    "webpack-cli": "^4.7.2"
  }
}
